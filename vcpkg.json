{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "devex-engine",
    "version": "0.1.0",
    "description": "Open-source 3D game engine",
    "license": "MIT",
    "builtin-baseline": "1577f17ee57f42a0ef6d75bbb82cb37d0b76d7e8",
    "vcpkg-configuration": {
        "overlay-ports": [
            "cmake/vcpkg-ports"
        ]
    },
    "dependencies": [
        {
            "name": "basisu",
            "platform": "!android"
        },
        "box2d",
        {
            "name": "curl",
            "default-features": false,
            "features": [
                "ssl"
            ],
            "platform": "!android"
        },
        "efsw",
        "enet",
        "fastgltf",
        "manifold",
        {
            "name": "freetype",
            "default-features": false
        },
        "glm",
        "joltphysics",
        "miniaudio",
        "nlohmann-json",
        "meshoptimizer",
        "mikktspace",
        "plutosvg",
        "recastnavigation",
        {
            "name": "sdl3",
            "features": [
                "vulkan"
            ]
        },
        "stb",
        "volk",
        "vulkan-memory-allocator",
        "zstd"
    ],
    "features": {
        "tests": {
            "description": "Build Devex unit tests",
            "dependencies": [
                "catch2"
            ]
        }
    }
}

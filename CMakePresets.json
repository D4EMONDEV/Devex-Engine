{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "environment": {
                "VSLANG": "1033"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "inherits": "linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-fuzz",
            "displayName": "Linux file-reader fuzzing (Clang)",
            "inherits": "linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "clang-21",
                "CMAKE_CXX_COMPILER": "clang++-21",
                "DEVEX_BUILD_FUZZERS": "ON",
                "DEVEX_BUILD_TESTS": "OFF",
                "DEVEX_BUILD_EDITOR": "OFF",
                "DEVEX_BUILD_PLAYER": "OFF"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android arm64 (NDK)",
            "description": "Cross-compiles the engine and the player for phones; needs ANDROID_NDK_HOME.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "arm64-android",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-29",
                "DEVEX_BUILD_EDITOR": "OFF",
                "DEVEX_BUILD_TESTS": "OFF"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-x64-debug",
            "configurePreset": "x64-debug"
        },
        {
            "name": "build-x64-release",
            "configurePreset": "x64-release"
        },
        {
            "name": "build-linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "build-linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "build-linux-fuzz",
            "configurePreset": "linux-fuzz",
            "targets": ["devex_fuzzers"]
        },
        {
            "name": "build-android-arm64",
            "configurePreset": "android-arm64"
        },
        {
            "name": "build-macos-debug",
            "configurePreset": "macos-debug"
        }
    ],
    "testPresets": [
        {
            "name": "test-x64-debug",
            "configurePreset": "x64-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-linux-debug",
            "configurePreset": "linux-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-linux-release",
            "configurePreset": "linux-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-macos-debug",
            "configurePreset": "macos-debug",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}

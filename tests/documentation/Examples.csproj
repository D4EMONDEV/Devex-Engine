<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the actual documentation examples against this build's generated component views. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DocumentationExamples</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(DevexDocumentationDirectory)/*.cs" />
    <Compile Include="../../docs/examples/guide-demarrage/*.cs" />
    <Reference Include="Devex.Managed">
      <HintPath>$(DevexManagedDirectory)/Devex.Managed.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

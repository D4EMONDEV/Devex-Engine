# Translates the shaders of the OpenGL renderer that slangc compiled to SPIR-V into GLSL ES 3.00, for OpenGL ES and WebGL2,
# and into GLSL 3.30, for OpenGL on a computer, then writes them into a C++ file: a browser has no files to load them from.
# cmake -DOUTPUT=<file.cpp> -DINPUTS=<a.slang;b.slang> -DSLANGC=<slangc> -DSPIRV_CROSS=<spirv-cross> -DWORK=<directory>
#       -P EmbedGlsl.cmake
#
# slangc compiles each entry point of a source on its own, which spirv-cross describes. GLSL ES 3.00 links what the
# vertex stage hands the fragment stage by name, which each stage spells its own way: both are renamed after their
# location, devex_varying<location>.

function(devex_run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        list(JOIN ARGN " " command)
        message(FATAL_ERROR "${command}\n${output}\n${error}")
    endif()
    set(devex_output "${output}" PARENT_SCOPE)
endfunction()

# The locations of the inputs or outputs that spirv-cross describes in `json`.
function(devex_locations json key result)
    set(locations "")
    string(JSON count ERROR_VARIABLE missing LENGTH "${json}" "${key}")
    if(NOT missing AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON location GET "${json}" "${key}" ${index} "location")
            list(APPEND locations ${location})
        endforeach()
    endif()
    set(${result} "${locations}" PARENT_SCOPE)
endfunction()

function(devex_hex text result)
    string(HEX "${text}" bytes)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    # Lines of a reasonable length.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n    " bytes "${bytes}")
    set(${result} "${bytes}0x00" PARENT_SCOPE)
endfunction()

file(MAKE_DIRECTORY "${WORK}")
set(content "// Written by cmake/EmbedGlsl.cmake from the shaders slangc compiled and spirv-cross translated: do not edit.\n")
string(APPEND content "#include \"GlShaders.hpp\"\n\nnamespace devex::render::opengl {\nnamespace {\n\n")
set(lookup "")
foreach(input IN LISTS INPUTS)
    cmake_path(GET input STEM name)
    set(module "${WORK}/${name}.spv")
    devex_run("${SLANGC}" "${input}" -target spirv -fvk-use-entrypoint-name -matrix-layout-column-major -DDEVEX_OPENGL=1
              -o "${module}")
    devex_run("${SPIRV_CROSS}" "${module}" --reflect)
    set(reflection "${devex_output}")
    string(JSON entries LENGTH "${reflection}" "entryPoints")
    math(EXPR last "${entries} - 1")
    foreach(index RANGE ${last})
        string(JSON entry GET "${reflection}" "entryPoints" ${index} "name")
        string(JSON mode GET "${reflection}" "entryPoints" ${index} "mode")
        if(mode STREQUAL "vert")
            set(stage vertex)
            set(renamed outputs)
            set(direction out)
        elseif(mode STREQUAL "frag")
            set(stage fragment)
            set(renamed inputs)
            set(direction in)
        else()
            message(FATAL_ERROR "${input}: ${entry} is neither a vertex nor a fragment shader, which OpenGL ES 3.0 has alone")
        endif()
        set(spirv "${WORK}/${entry}.spv")
        devex_run("${SLANGC}" "${input}" -target spirv -entry "${entry}" -stage ${stage} -matrix-layout-column-major
                  -DDEVEX_OPENGL=1 -o "${spirv}")
        devex_run("${SPIRV_CROSS}" "${spirv}" --reflect)
        devex_locations("${devex_output}" ${renamed} locations)
        set(renames "")
        foreach(location IN LISTS locations)
            list(APPEND renames --rename-interface-variable ${direction} ${location} "devex_varying${location}")
        endforeach()
        devex_run("${SPIRV_CROSS}" "${spirv}" --es --version 300 --no-420pack-extension ${renames})
        devex_hex("${devex_output}" es)
        devex_run("${SPIRV_CROSS}" "${spirv}" --no-es --version 330 --no-420pack-extension ${renames})
        devex_hex("${devex_output}" core)
        string(APPEND content "constexpr unsigned char ${entry}Es[] = {\n    ${es}};\n\n")
        string(APPEND content "constexpr unsigned char ${entry}Core[] = {\n    ${core}};\n\n")
        string(APPEND lookup "    if (name == \"${entry}\")\n    {\n        return es ? std::string_view{reinterpret_cast<const char*>(${entry}Es), sizeof(${entry}Es) - 1}\n")
        string(APPEND lookup "                  : std::string_view{reinterpret_cast<const char*>(${entry}Core), sizeof(${entry}Core) - 1};\n    }\n")
    endforeach()
endforeach()
string(APPEND content "} // namespace\n\nstd::string_view shaderSource(std::string_view name, bool es) noexcept\n{\n${lookup}    return {};\n}\n\n")
string(APPEND content "} // namespace devex::render::opengl\n")
file(WRITE "${OUTPUT}.new" "${content}")
file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.new")

# The Devex engine for game modules: find_package(Devex CONFIG) with Devex_DIR set to this folder,
# as the editor does when it builds the code/ folder of a project. Generated by the engine build,
# whose configuration game modules must share (@CMAKE_BUILD_TYPE@): same compiler, same runtime.
cmake_minimum_required(VERSION 3.25)

set(DEVEX_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
if(CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL DEVEX_BUILD_TYPE)
    message(FATAL_ERROR "Game modules are built in ${DEVEX_BUILD_TYPE}, like the engine, not in ${CMAKE_BUILD_TYPE}.")
endif()

if(NOT TARGET Devex::Engine)
    add_library(Devex::Engine SHARED IMPORTED)
    set_target_properties(Devex::Engine PROPERTIES
        IMPORTED_LOCATION "$<TARGET_FILE:devex_engine>"
        IMPORTED_IMPLIB "$<TARGET_LINKER_FILE:devex_engine>"
        INTERFACE_INCLUDE_DIRECTORIES "@PROJECT_SOURCE_DIR@/engine/include;$<TARGET_PROPERTY:glm::glm-header-only,INTERFACE_INCLUDE_DIRECTORIES>"
        INTERFACE_COMPILE_DEFINITIONS "GLM_FORCE_DEPTH_ZERO_TO_ONE;$<$<NOT:$<CONFIG:Release,MinSizeRel>>:DEVEX_ENABLE_ASSERTS>"
        INTERFACE_COMPILE_FEATURES "cxx_std_23"
    )
endif()

# Keeps header dependencies working with a localized MSVC.
include("@PROJECT_SOURCE_DIR@/cmake/DevexShowIncludes.cmake")

# devex_add_game_module(SOURCES <files...>)
# Builds the game module, Game.dll, into bin/ of the build folder, where the editor and the player
# load it from.
function(devex_add_game_module)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "" "SOURCES")
    add_library(Game SHARED ${ARG_SOURCES})
    target_link_libraries(Game PRIVATE Devex::Engine)
    set_target_properties(Game PROPERTIES
        CXX_EXTENSIONS OFF
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
    )
    if(MSVC)
        target_compile_options(Game PRIVATE /W4 /permissive- /utf-8 /Zc:__cplusplus /Zc:preprocessor)
    endif()
endfunction()
